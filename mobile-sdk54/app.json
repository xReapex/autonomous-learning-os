{
  "expo": {
    "name": "SCIO",
    "slug": "scio-preview-v4",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "icon": "./assets/brand/icon-v5.png",
    "scheme": "scio",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7F6",
    "splash": {
      "backgroundColor": "#F5F7F6",
      "image": "./assets/brand/splash-v5.png",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "io.scio.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.scio.app",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#0B5D57",
        "foregroundImage": "./assets/brand/adaptive-foreground-v5.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome-v5.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon-v5.png",
      "backgroundColor": "#F5F7F6"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F6",
          "image": "./assets/brand/splash-v5.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
