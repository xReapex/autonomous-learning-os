# BizOS × Learning — configuration
#
# Copie ce fichier en .env.local (c'est ce que fait scripts/01-scaffold.sh).
# .env.local est git-ignoré. Aucune valeur réelle ne doit jamais atterrir ici.

# ── Identité de l'espace ─────────────────────────────────────────────────────
# Affiché sous le wordmark "BizOS × Learning".
NEXT_PUBLIC_LEARNING_SUBJECT=Apprentissage

# Durée de session par défaut : 15 | 30 | 45 | 60 | 90 | 120 | 180
NEXT_PUBLIC_DEFAULT_SESSION_MINUTES=30

# Fond d'écran au premier lancement. Voir src/lib/wallpapers.ts pour la liste,
# ou dépose une image dans public/wallpapers/ et mets son nom de fichier.
NEXT_PUBLIC_DEFAULT_WALLPAPER=desk

# ── Stockage de la progression ───────────────────────────────────────────────
# file      → .data/*.json sur cette machine (défaut, rien à configurer)
# postgres  → DATABASE_URL requis
STORAGE_DRIVER=file

# Supabase / Railway / Neon / Postgres auto-hébergé.
# Laisse vide en mode file. N'écris JAMAIS une vraie URL dans .env.example.
DATABASE_URL=

# Mets `require` pour Supabase, Neon et la plupart des Postgres managés.
PGSSL=

# ── Correction des exercices ─────────────────────────────────────────────────
# claude-code → aucune clé. L'app génère le prompt, tu le donnes à ton agent.
# cli         → l'app appelle une CLI locale (claude ou codex). Aucune clé stockée.
# api         → ta clé, ton compte, ton coût.
AI_PROVIDER=claude-code

# Mode cli uniquement : le binaire à appeler.
AI_CLI_BIN=claude

# Mode api uniquement : anthropic | openai
AI_API_VENDOR=anthropic

# Mode api uniquement : ta clé. Ne la colle jamais dans un chat ni dans un commit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modèle utilisé en mode api. Vide = défaut du fournisseur.
AI_MODEL=

# ── Brief Telegram (optionnel) ───────────────────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Verrou d'accès (optionnel) ───────────────────────────────────────────────
# Vide = pas de mot de passe. Utile seulement si tu déploies l'app en ligne.
APP_PASSWORD=
