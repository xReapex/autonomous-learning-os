{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gquthier/autonomous-learning-os/research/curriculum.schema.json",
  "title": "Learning OS curriculum",
  "description": "Le contrat entre la deep research et l'app. Tout ce que les sous-agents produisent doit passer ce schéma avant d'atterrir dans app/content/curriculum.json.",
  "type": "object",
  "required": ["version", "subject", "goal", "generatedAt", "subjects", "cards"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "description": "Version du format. Incrémentée seulement sur rupture."
    },
    "subject": {
      "type": "string",
      "minLength": 2,
      "description": "Le sujet tel que l'utilisateur l'a formulé, affiché sous le wordmark."
    },
    "goal": {
      "type": "string",
      "minLength": 10,
      "description": "Le résultat vérifiable visé. Doit être observable, pas 'comprendre X'."
    },
    "level": {
      "type": "string",
      "enum": ["debutant", "intermediaire", "avance"],
      "default": "debutant"
    },
    "sessionMinutes": {
      "type": "integer",
      "enum": [15, 30, 45, 60, 90, 120, 180],
      "default": 30
    },
    "generatedAt": {
      "type": "string",
      "format": "date",
      "description": "Date de génération. Sert à repérer un curriculum qui vieillit."
    },
    "language": { "type": "string", "default": "fr" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Les matières. Trois actives maximum recommandées — au-delà, la révision se dilue.",
      "items": { "$ref": "#/$defs/subject" }
    },
    "cards": {
      "type": "array",
      "minItems": 3,
      "description": "Les cartes de révision espacée initiales.",
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["id", "icon", "title", "level", "lessons"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "description": "Un glyphe monospace (↗ ◌ ◐ ✦ ⌁ △ ≋ ✣ ◇ ◎). Jamais un emoji couleur : ça casse le rendu du bureau."
        },
        "title": { "type": "string", "minLength": 2 },
        "level": { "type": "string", "minLength": 2, "description": "Sous-titre libre : 'Fondations · débutant'." },
        "progress": { "type": "integer", "minimum": 0, "maximum": 100, "default": 0 },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lesson" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "required": ["id", "title", "objective", "keyTakeaways", "prompt", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{3,60}$" },
        "title": { "type": "string", "minLength": 3 },
        "objective": {
          "type": "string",
          "minLength": 10,
          "description": "Ce que l'apprenant doit pouvoir faire après. Un verbe d'action, pas 'découvrir'."
        },
        "keyTakeaways": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 10 }
        },
        "prompt": {
          "type": "string",
          "minLength": 20,
          "description": "L'exercice de transfert. Doit demander une application, pas une définition."
        },
        "source": { "$ref": "#/$defs/source" },
        "alternatives": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/source" },
          "description": "Sources de repli, quand deux agents en ont proposé de valables."
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "provider", "kind", "url", "minutes", "why", "access", "accessNote", "verifiedAt", "segmentLabel"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3, "description": "Titre exact, dans sa langue d'origine." },
        "provider": { "type": "string", "minLength": 2, "description": "Institution / auteur. 'Stanford / Leonard Susskind'." },
        "kind": { "type": "string", "enum": ["video", "reading", "interactive"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "embedUrl": {
          "type": "string",
          "pattern": "^https://www\\.youtube-nocookie\\.com/embed/",
          "description": "Requis pour kind=video si on veut le lecteur tracké. youtube-nocookie uniquement."
        },
        "totalMinutes": { "type": "integer", "minimum": 1, "description": "Durée totale de la ressource." },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60,
          "description": "La capsule à regarder aujourd'hui. C'est le cœur du produit : jamais le cours entier par défaut."
        },
        "why": {
          "type": "string",
          "minLength": 20,
          "description": "Pourquoi CETTE source pour CETTE notion à CE niveau. 'C'est un bon cours' est refusé."
        },
        "access": { "const": "free" },
        "accessNote": {
          "type": "string",
          "minLength": 10,
          "description": "Comment on y accède gratuitement, et ce qui est payant mais optionnel."
        },
        "verifiedAt": {
          "type": "string",
          "format": "date",
          "description": "Date où le lien a été ouvert et confirmé. Pas d'estimation."
        },
        "segmentLabel": {
          "type": "string",
          "minLength": 5,
          "description": "Ce que couvre le segment. 'Lecture 8, chapitre 3 : valeur actualisée'."
        },
        "segmentStartSeconds": { "type": "integer", "minimum": 0, "default": 0 }
      }
    },
    "card": {
      "type": "object",
      "required": ["id", "type", "front", "back"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "type": { "type": "string", "minLength": 2, "description": "Catégorie affichée : 'Modèle mental', 'Définition'…" },
        "front": { "type": "string", "minLength": 10, "description": "Une question récupérable. Pas un titre." },
        "back": { "type": "string", "minLength": 10 },
        "subjectId": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "lessonId": { "type": "string", "pattern": "^[a-z0-9-]{3,60}$" }
      }
    }
  }
}
