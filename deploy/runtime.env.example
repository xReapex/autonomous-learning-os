# Copier vers /etc/autonomous-learning-os/runtime.env, propriétaire root:root,
# permissions 0600. Ne jamais committer la vraie valeur du secret.
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTED_SAFE_MODE=true
STORAGE_DRIVER=file
LEARNING_DATA_DIR=/var/lib/autonomous-learning-os
TELEGRAM_ENABLED=false
APP_URL=https://learning-os.example.com
CURRICULUM_MUTATION_SECRET=replace-with-at-least-32-random-characters
CODEX_INTERVIEW_WORKER_SECRET=replace-with-a-distinct-32-character-secret
SCIO_DEPLOYMENT_ENV=production
SCIO_AUTH_MODE=social
SCIO_AUTH_DATA_DIR=/var/lib/autonomous-learning-os/scio-auth
SCIO_USER_DATA_DIR=/var/lib/autonomous-learning-os/scio-users
SCIO_GENERATION_JOBS_DIR=/var/lib/scio-generation-jobs/production
# Audiences publiques attendues dans les ID tokens, vérifiées côté serveur.
SCIO_GOOGLE_SERVER_CLIENT_ID=replace-with-google-web-server-oauth-client-id
SCIO_APPLE_CLIENT_ID=io.scio.app
