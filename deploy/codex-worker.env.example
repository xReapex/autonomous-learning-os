# Fichier root:root 0600. Le worker lit son OAuth privé depuis le chemin indiqué.
NODE_ENV=production
CODEX_AUTH_FILE=/var/lib/learningos-codex/auth.json
CODEX_INTERVIEW_WORKER_SECRET=replace-with-at-least-32-random-characters
CODEX_INTERVIEW_TIMEOUT_MS=300000
SCIO_PRODUCTION_GENERATION_JOBS_DIR=/var/lib/scio-generation-jobs/production
SCIO_PREVIEW_GENERATION_JOBS_DIR=/var/lib/scio-generation-jobs/preview
